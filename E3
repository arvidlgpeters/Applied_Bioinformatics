reads <- c("BAA", "AAB", "BBA", "ABA", "ABB", "BBB", "AAA", "BAB")
scs <- greedy_shortest_common_superstring(reads)
stopifnot(nchar(scs) == 10,
          all(vapply(reads, function(r) grepl(r, scs, fixed = TRUE), logical(1))))

